{
  "name": "financial-ratio-analyzer",
  "version": "0.1.0",
  "description": "Interactive financial health assessment and scenario-analysis platform for simplified corporate financial statements.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --exclude 'src/test/backend-*.test.ts' && vitest run --config vitest.backend.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/server/db/run-migrations.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/server/db/seed.ts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx src/server/db/check-connection.ts",
    "db:live:check": "node --env-file-if-exists=.env.local --import tsx src/server/db/live-integration-check.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:test": "vitest run --config vitest.backend.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igarciatrueba/FINANCIAL-RATIO-ANALYZER.git"
  },
  "keywords": [
    "finance",
    "ratio-analysis",
    "nextjs",
    "typescript"
  ],
  "author": "Iker García Trueba",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/igarciatrueba/FINANCIAL-RATIO-ANALYZER/issues"
  },
  "homepage": "https://github.com/igarciatrueba/FINANCIAL-RATIO-ANALYZER#readme",
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
